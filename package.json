{
  "name": "azure-secret-manager",
  "version": "1.1.0",
  "description": "Tiny Azure Key Vault helper \u2014 get secrets with DefaultAzureCredential, caching, and a clean API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test tests/secrets.test.js",
    "prepublishOnly": "npm test && npm run build",
    "build": "tsup src/index.js --format cjs --clean --sourcemap"
  },
  "keywords": [
    "azure",
    "key-vault",
    "secrets",
    "keyvault",
    "credential",
    "devops",
    "cloud",
    "azure-keyvault",
    "key-vault-secrets",
    "secret-management",
    "azure-identity",
    "default-azure-credential",
    "nodejs",
    "security",
    "config"
  ],
  "author": "anilachary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfyark/azure-secret-manager.git"
  },
  "bugs": {
    "url": "https://github.com/theinfyark/azure-secret-manager/issues"
  },
  "homepage": "https://github.com/theinfyark/azure-secret-manager#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@azure/identity": "^4.10.1",
    "@azure/keyvault-secrets": "^4.9.0"
  },
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anilachary"
  },
  "module": "./src/index.js",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.23",
    "browserslist": ">=4.28.7",
    "brace-expansion": ">=2.1.4"
  }
}
